{
  "name": "@loomup/nuxt",
  "version": "0.1.7",
  "description": "Nuxt module for Loomup (cookie sessions, server client, Vue composables)",
  "type": "module",
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./server": {
      "types": "./dist/runtime/server/client.d.ts",
      "import": "./dist/runtime/server/client.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/runtime"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.js",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@loomup/client": ">=0.1.0",
    "nuxt": ">=3.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "^3.15.0"
  },
  "devDependencies": {
    "@loomup/client": "0.1.7",
    "@types/node": "^22.0.0",
    "h3": "^1.13.0",
    "nuxt": "^3.15.0",
    "typescript": "^5.7.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://tryloomup.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluppco/loomup-js.git",
    "directory": "packages/nuxt"
  },
  "bugs": {
    "url": "https://github.com/bluppco/loomup-js/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
