{
  "name": "@loomup/vue",
  "version": "0.1.6",
  "description": "Vue 3 composables and plugin for Loomup Realtime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --experimental-vm-modules --import ./dist/test/setup.js --test dist/test/composables.test.js",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@loomup/client": ">=0.1.0",
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@loomup/client": "0.1.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://tryloomup.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluppco/loomup-js.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/bluppco/loomup-js/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
